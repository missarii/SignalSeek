generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { OWNER ADMIN ANALYST VIEWER }
enum InvestigationStatus { DRAFT QUEUED RUNNING COMPLETED FAILED CANCELLED }
enum EvidenceStatus { SUPPORTED PARTIALLY_SUPPORTED CONTRADICTED INSUFFICIENT NOT_EVALUATED }

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      WorkspaceMember[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
}
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model Workspace {
  id            String   @id @default(uuid())
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       WorkspaceMember[]
  investigations Investigation[]
  reports       Report[]
  monitors      Monitor[]
  alerts        Alert[]
  integrations  Integration[]
  usage         UsageRecord[]
  entities      Entity[]
}
model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @default(ANALYST)
  createdAt   DateTime @default(now())
  @@unique([workspaceId, userId])
  @@index([userId])
}
model Investigation {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  question    String
  description String?
  status      InvestigationStatus @default(DRAFT)
  depth       String  @default("standard")
  maxRounds   Int     @default(4)
  maxQueries  Int     @default(20)
  maxSources  Int     @default(50)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        ResearchPlan?
  runs        InvestigationRun[]
  queries     SearchQuery[]
  sources     Source[]
  claims      Claim[]
  contradictions Contradiction[]
  reports     Report[]
  events      InvestigationEvent[]
  checkpoints AgentCheckpoint[]
}
model ResearchPlan {
  id              String   @id @default(uuid())
  investigationId String   @unique
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  objective       String
  subquestions    Json     @default("[]")
  searchQueries   Json     @default("[]")
  sourceCategories Json    @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model InvestigationRun {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  status          String   @default("RUNNING")
  round           Int      @default(0)
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  error           String?
  tokenUsage      Int      @default(0)
  costEstimate    Float    @default(0)
  @@index([investigationId])
}
model AgentCheckpoint {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  state           Json
  createdAt       DateTime @default(now())
  @@index([investigationId])
}
model SearchQuery {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  query           String
  round           Int      @default(0)
  provider        String   @default("mock")
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())
  @@index([investigationId])
}
model Source {
  id              String   @id @default(uuid())
  investigationId String?
  investigation   Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  workspaceId     String?
  url             String
  canonicalUrl    String
  title           String?
  snippet         String?
  provider        String   @default("mock")
  sourceType      String   @default("web")
  publishedAt     DateTime?
  retrievedAt     DateTime @default(now())
  contentHash     String?
  author          String?
  createdAt       DateTime @default(now())
  snapshots       SourceSnapshot[]
  passages        Passage[]
  @@index([investigationId])
  @@index([canonicalUrl])
}
model SourceSnapshot {
  id        String   @id @default(uuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content   String
  contentHash String?
  createdAt DateTime @default(now())
  @@index([sourceId])
}
model Passage {
  id        String   @id @default(uuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  text      String
  locator   String?
  createdAt DateTime @default(now())
  evidence  Evidence[]
  @@index([sourceId])
}
model Claim {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  text            String
  status          EvidenceStatus @default(NOT_EVALUATED)
  createdAt       DateTime @default(now())
  evidenceLinks   ClaimEvidenceLink[]
  @@index([investigationId])
}
model Evidence {
  id        String   @id @default(uuid())
  passageId String
  passage   Passage  @relation(fields: [passageId], references: [id], onDelete: Cascade)
  quote     String
  method    String   @default("extraction")
  result    EvidenceStatus @default(SUPPORTED)
  createdAt DateTime @default(now())
  links     ClaimEvidenceLink[]
  relEvidence RelationshipEvidence[]
  @@index([passageId])
}
model ClaimEvidenceLink {
  id         String   @id @default(uuid())
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  relation   String   @default("supports")
  @@unique([claimId, evidenceId])
}
model Contradiction {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  claimA          String
  claimB          String
  kind            String   @default("genuine")
  explanation     String?
  createdAt       DateTime @default(now())
  @@index([investigationId])
}
model Entity {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  normalized  String
  type        String   @default("Concept")
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  aliases     EntityAlias[]
  outEdges    Relationship[] @relation("out")
  inEdges     Relationship[] @relation("in")
  @@unique([workspaceId, normalized])
  @@index([workspaceId])
}
model EntityAlias {
  id       String @id @default(uuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  alias    String
  @@index([entityId])
}
model Relationship {
  id         String   @id @default(uuid())
  fromId     String
  from       Entity   @relation("out", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String
  to         Entity   @relation("in", fields: [toId], references: [id], onDelete: Cascade)
  type       String   @default("RELATED_TO")
  createdAt  DateTime @default(now())
  evidence   RelationshipEvidence[]
  @@index([fromId])
  @@index([toId])
}
model RelationshipEvidence {
  id             String   @id @default(uuid())
  relationshipId String
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  evidenceId     String
  evidence       Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  @@unique([relationshipId, evidenceId])
}
model Report {
  id              String   @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  title           String
  markdown        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions        ReportVersion[]
  citations       Citation[]
}
model ReportVersion {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version   Int
  markdown  String
  createdAt DateTime @default(now())
  @@unique([reportId, version])
}
model Citation {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  key       String
  url       String?
  sourceId  String?
  excerpt   String?
  @@unique([reportId, key])
}
model Monitor {
  id              String   @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  topic           String
  query           String
  schedule        String   @default("daily")
  paused          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  snapshots       MonitorSnapshot[]
  scheduledRuns   ScheduledRun[]
}
model MonitorSnapshot {
  id        String   @id @default(uuid())
  monitorId String
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  claimHash String
  claims    Json     @default("[]")
  createdAt DateTime @default(now())
  @@index([monitorId])
}
model Alert {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitorId   String?
  title       String
  detail      String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([workspaceId])
}
model ScheduledRun {
  id        String   @id @default(uuid())
  monitorId String
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status    String   @default("QUEUED")
  runAt     DateTime @default(now())
  finishedAt DateTime?
  error     String?
}
model Integration {
  id          String   @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        String
  provider    String
  status      String   @default("unconfigured")
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model UsageRecord {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        String
  quantity    Float
  costEstimate Float   @default(0)
  createdAt   DateTime @default(now())
  @@index([workspaceId])
}
