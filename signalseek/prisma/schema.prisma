generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { OWNER ADMIN ANALYST VIEWER }
enum InvestigationStatus { DRAFT QUEUED RUNNING COMPLETED FAILED CANCELLED }
enum EvidenceStatus { SUPPORTED PARTIALLY_SUPPORTED CONTRADICTED INSUFFICIENT NOT_EVALUATED }

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      WorkspaceMember[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
}
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model Workspace {
  id            String   @id @default(uuid())
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       WorkspaceMember[]
  investigations Investigation[]
  reports       Report[]
  monitors      Monitor[]
  alerts        Alert[]
  integrations  Integration[]
  usage         UsageRecord[]
  entities      Entity[]
}
model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @default(ANALYST)
  createdAt   DateTime @default(now())
  @@unique([workspaceId, userId])
  @@index([userId])
}
model Investigation {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  question    String
  description String?
  status      InvestigationStatus @default(DRAFT)
  depth       String  @default("standard")
  maxRounds   Int     @default(4)
  maxQueries  Int     @default(20)
  maxSources  Int     @default(50)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        ResearchPlan?
  runs        InvestigationRun[]
  queries     SearchQuery[]
  sources     Source[]
  claims      Claim[]
  contradictions Contradiction[]
  reports     Report[]
  events      InvestigationEvent[]
  checkpoints AgentCheckpoint[]
}
model ResearchPlan {
  id              String   @id @default(uuid())
  investigationId String   @unique
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  objective       String
  subquestions    Json     @default("[]")
  searchQueries   Json     @default("[]")
  sourceCategories Json    @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model InvestigationRun {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  status          String   @default("RUNNING")
  round           Int      @default(0)
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  error           String?
  tokenUsage      Int      @default(0)
  costEstimate    Float    @default(0)
  @@index([investigationId])
}
model AgentCheckpoint {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  state           Json
  createdAt       DateTime @default(now())
  @@index([investigationId])
}
model SearchQuery {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  query           String
  round           Int      @default(0)
  provider        String   @default("mock")
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())
  @@index([investigationId])
}
model Source {
  id              String   @id @default(uuid())
  investigationId String?
  investigation   Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)
  workspaceId     String?
  url             String
  canonicalUrl    String
  title           String?
  snippet         String?
  provider        String   @default("mock")
  sourceType      String   @default("web")
  publishedAt     DateTime?
  retrievedAt     DateTime @default(now())
  contentHash     String?
  author          String?
  createdAt       DateTime @default(now())
  snapshots       SourceSnapshot[]
  passages        Passage[]
  @@index([investigationId])
  @@index([canonicalUrl])
}
model SourceSnapshot {
  id        String   @id @default(uuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  content   String
  contentHash String?
  createdAt DateTime @default(now())
  @@index([sourceId])
}
model Passage {
  id        String   @id @default(uuid())
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  text      String
  locator   String?
  createdAt DateTime @default(now())
  evidence  Evidence[]
  @@index([sourceId])
}
model Claim {
  id              String   @id @default(uuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
