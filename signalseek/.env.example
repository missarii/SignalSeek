REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars-minimum-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars-minimum-please
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
