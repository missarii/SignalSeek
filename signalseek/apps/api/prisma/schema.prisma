generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { OWNER ADMIN ANALYST VIEWER }
enum InvestigationStatus { DRAFT QUEUED RUNNING COMPLETED FAILED CANCELLED }
enum EvidenceStatus { SUPPORTED PARTIALLY_SUPPORTED CONTRADICTED INSUFFICIENT NOT_EVALUATED }

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      WorkspaceMember[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
}
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model Workspace {
  id            String   @id @default(uuid())
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       WorkspaceMember[]
  investigations Investigation[]
  reports       Report[]
  monitors      Monitor[]
  alerts        Alert[]
  integrations  Integration[]
  usage         UsageRecord[]
  entities      Entity[]
}
model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @default(ANALYST)
  createdAt   DateTime @default(now())
  @@unique([workspaceId, userId])
  @@index([userId])
}
model Investigation {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  question    String
  description String?
  status      InvestigationStatus @default(DRAFT)
  depth       String  @default("standard")
  maxRounds   Int     @default(4)
  maxQueries  Int     @default(20)
  maxSources  Int     @default(50)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        ResearchPlan?
  runs        InvestigationRun[]
  queries     SearchQuery[]
  sources     Source[]
  claims      Claim[]
  contradictions Contradiction[]
  reports     Report[]
  events      InvestigationEvent[]
  checkpoints AgentCheckpoint[]
}
model ResearchPlan {
  id              String   @id @default(uuid())
  investigationId String   @unique
